{
	"name": "@benord-labs/frink-primitives",
	"version": "0.5.3",
	"description": "Frink shared UI primitives + design tokens (Tailwind v4).",
	"type": "module",
	"license": "UNLICENSED",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/benord-labs/frink-primitives.git"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"sideEffects": [
		"*.css"
	],
	"files": [
		"src",
		"styles",
		"eslint-rules",
		"designs"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./styles": "./styles/index.css",
		"./styles/theme.css": "./styles/theme.css",
		"./styles/components.css": "./styles/components.css",
		"./eslint": "./eslint-rules/index.mjs",
		"./eslint/no-raw-color": "./eslint-rules/no-raw-color.mjs"
	},
	"scripts": {
		"ts:check": "tsc --noEmit",
		"test": "bun test",
		"lint": "biome check .",
		"format": "biome check --write .",
		"prepare": "husky || true",
		"guard:freeze": "guard-fanout freeze && guard-size freeze",
		"lint:structure": "eslint src"
	},
	"dependencies": {
		"@radix-ui/react-slot": "^1.3.0",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.0.0"
	},
	"peerDependencies": {
		"react": ">=19",
		"react-dom": ">=19",
		"tailwindcss": ">=4",
		"lucide-react": ">=0.5",
		"class-variance-authority": ">=0.7",
		"eslint": ">=9",
		"@typescript-eslint/parser": ">=8"
	},
	"peerDependenciesMeta": {
		"eslint": {
			"optional": true
		},
		"@typescript-eslint/parser": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@typescript-eslint/parser": "^8.0.0",
		"class-variance-authority": "^0.7.1",
		"eslint": "^9.39.0",
		"lucide-react": "^0.577.0",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"typescript": "^5.9.3",
		"husky": "^9.1.7",
		"jscpd": "^4.2.4",
		"eslint-plugin-project-structure": "^3.0.0"
	}
}
